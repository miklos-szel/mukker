<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Mukker.App</RootNamespace>
    <AssemblyName>Mukker</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\mukker.ico</ApplicationIcon>
    <StartupObject>Mukker.App.Program</StartupObject>
    <Product>Mukker</Product>
    <Company>Mukker</Company>
    <InvariantGlobalization>false</InvariantGlobalization>
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Mukker.Core/Mukker.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\mukker.ico" />
    <Resource Include="Assets\Sounds\dictation-start.wav" />
    <Resource Include="Assets\Sounds\dictation-stop.wav" />
    <Resource Include="Assets\Sounds\dictation-paste.wav" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="NAudio.WinMM" Version="2.2.1" />
  </ItemGroup>
  <!-- Dictation's engine (transcribe.cpp + ggml), fetched by scripts/fetch-native.sh. Only an x64 build
       exists, so only the win-x64 publish carries it; publish.sh packs it into the single-file exe. -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <None Include="..\..\native\win-x64\*.dll" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
