<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Mukker.App</RootNamespace>
    <AssemblyName>Mukker</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\mukker.ico</ApplicationIcon>
    <StartupObject>Mukker.App.Program</StartupObject>
    <Product>Mukker</Product>
    <Company>Mukker</Company>
    <InvariantGlobalization>false</InvariantGlobalization>
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Mukker.Core/Mukker.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\mukker.ico" />
  </ItemGroup>
</Project>
